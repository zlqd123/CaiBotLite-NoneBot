# CaiBotLite NoneBot 插件配置示例
# 复制到机器人工程的 .env 后按需修改; 全部配置项见仓库 README 或 config.py

# 与 TShock 端 /cbl onebot 里的 通讯密钥 一致(必填)
CAIBOTLITE__SECRET=改成你自己的随机串

# auto = 监听+主动连两条链路都试, 先通的生效(默认, 跨网络可用)
CAIBOTLITE__MODE=auto

# TShock 端地址(client / auto 模式使用)
#CAIBOTLITE__SERVER_URL=ws://127.0.0.1:17779/onebot/v11/ws

# 机器人管理员 QQ(可执行远程指令/地图下载; 群管理身份不算)
#CAIBOTLITE__ADMINS=[10000]

# 服务器主动发来的消息默认回送的群号
#CAIBOTLITE__DEFAULT_GROUP=10000

# 允许使用机器人的群号, 留空不限制
#CAIBOTLITE__GROUPS=[]

# 排行榜每页条数
#CAIBOTLITE__RANK_LIMIT=10

# 查背包渲染成图片(素材缺失或出错时自动回退纯文本)
#CAIBOTLITE__BAG_IMAGE=true
